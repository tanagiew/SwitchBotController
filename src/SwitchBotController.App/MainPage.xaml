<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SwitchBotController.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SwitchBotController.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:SwitchBotController.App.ViewModels"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="32,24,32,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="デバイス" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.DeviceSummary, Mode=OneWay}" />
                <TextBlock
                    MaxWidth="620"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.ConfigLocation}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ConfigLocation}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.ReloadCommand}"
                    ToolTipService.ToolTip="config.jsonを再読み込み">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="再読み込み" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ListView
                ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DeviceControlViewModel">
                        <Border
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="48"
                                    Height="48"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="24">
                                    <FontIcon
                                        FontSize="22"
                                        Foreground="White"
                                        Glyph="&#xE7E8;" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing
                                            Width="14"
                                            Height="14"
                                            IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        MinWidth="82"
                                        Command="{x:Bind TurnOnCommand}"
                                        Content="ON"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        MinWidth="82"
                                        Command="{x:Bind TurnOffCommand}"
                                        Content="OFF" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                <FontIcon
                    FontSize="42"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE8C8;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="デバイスがありません" />
                <TextBlock
                    MaxWidth="520"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="config.jsonを確認してから、再読み込みしてください。" />
                <TextBlock
                    MaxWidth="520"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.ConfigLocation}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsInfoStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Informational" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsErrorStatus, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Error" />
        </Grid>
    </Grid>
</Page>
