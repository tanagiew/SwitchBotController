<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SwitchBotController.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SwitchBotController.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:SwitchBotController.App.ViewModels"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="24,20,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.DeviceSummary, Mode=OneWay}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ProgressRing
                    Width="18"
                    Height="18"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <Button
                    Width="40"
                    Height="40"
                    AutomationProperties.Name="config.jsonを再読み込み"
                    Command="{x:Bind ViewModel.ReloadCommand}"
                    ToolTipService.ToolTip="config.jsonを再読み込み">
                    <FontIcon FontSize="15" Glyph="&#xE72C;" />
                </Button>
                <Button
                    x:Name="SettingsButton"
                    Width="40"
                    Height="40"
                    AutomationProperties.Name="設定"
                    ToolTipService.ToolTip="設定ファイルを選択">
                    <FontIcon FontSize="15" Glyph="&#xE713;" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="380" Spacing="12">
                                <TextBlock
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="設定" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="設定ファイル" />
                                <TextBox
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.ConfigLocation, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Click="OnOpenConfigClicked"
                                        Content="ファイルを開く"
                                        IsEnabled="{x:Bind ViewModel.IsSettingsInteractionEnabled, Mode=OneWay}" />
                                    <Button
                                        Click="OnChooseConfigClicked"
                                        Content="別のファイルを選択"
                                        IsEnabled="{x:Bind ViewModel.IsSettingsInteractionEnabled, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="APIトークンとデバイス情報はconfig.jsonに保持され、アプリにはファイルの場所だけを保存します。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ListView
                ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DeviceControlViewModel">
                        <Border
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="3">
                                    <TextBlock
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing
                                            Width="14"
                                            Height="14"
                                            IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        MinWidth="68"
                                        Command="{x:Bind TurnOnCommand}"
                                        Content="ON"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        MinWidth="68"
                                        Command="{x:Bind TurnOffCommand}"
                                        Content="OFF" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                <FontIcon
                    FontSize="42"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE8C8;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="デバイスがありません" />
                <TextBlock
                    MaxWidth="520"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="config.jsonを確認してから、再読み込みしてください。" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="2"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />
    </Grid>
</Page>
